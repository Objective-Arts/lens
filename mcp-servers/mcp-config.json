{
  "mcpServers": {
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "gemini-reviewer": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@objective-arts/mcp-server-gemini-reviewer"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "qodana": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@objective-arts/mcp-server-qodana"]
    }
  }
}
