{
  "name": "@objective-arts/lens",
  "version": "0.4.0",
  "description": "Lens - AI Assisted Development That Builds In Quality",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lens": "./dist/cli/index.js",
    "lens-reset": "./scripts/reset.sh"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets && npm run chmod-bins",
    "copy-assets": "mkdir -p dist/ui && cp src/ui/*.html dist/ui/ 2>/dev/null || true",
    "chmod-bins": "chmod +x dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "quality-gate": "tsx scripts/quality-gate.ts",
    "check": "npm run lint && npm run quality-gate",
    "pretest": "npm run check",
    "test": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude-code",
    "configuration",
    "skills",
    "mcp"
  ],
  "author": "Objective Arts LLC",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/objective-arts/lens.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist/",
    "canon/",
    "profiles/",
    "workflow-skills/",
    "config/",
    "scripts/pipeline.sh",
    "scripts/reset.sh",
    ".claude/skills/",
    ".claude/phases/",
    ".claude/rubric/",
    ".claude/plans/",
    ".claude/config/",
    "mcp-servers/"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^2.1.0"
  }
}
