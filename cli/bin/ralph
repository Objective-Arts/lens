TEST_COMMAND: [npm test / pytest / go test / cargo test]
SCAFFOLD_COMPLETE

If blocked: SCAFFOLD_FAILED: [reason]
EOF

# ═══════════════════════════════════════════════════════════
# PRE-LOOP: ENSURE TEST INFRASTRUCTURE EXISTS
# ═══════════════════════════════════════════════════════════
has_test_infrastructure() {
  # Check for test script in package.json (must be "test": not just "test" anywhere)
  if [ -f "package.json" ]; then
    grep -q '"test":' package.json && return 0
  fi
  # Check for pytest in pyproject.toml
  if [ -f "pyproject.toml" ]; then
    grep -qE '(pytest|test)' pyproject.toml && return 0
  fi
  # Check for go.mod (go test is built-in)
  if [ -f "go.mod" ]; then
    return 0
  fi
  # Check for Cargo.toml (cargo test is built-in)
  if [ -f "Cargo.toml" ]; then
    return 0
  fi
  return 1
}

if ! has_test_infrastructure; then
  echo -e "${YELLOW}⚙️  No test infrastructure detected - setting up...${NC}"

  SCAFFOLD_LOG="$LOG_DIR/scaffold_$(date +%H%M%S)"
  SESSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')

  P_SCAFFOLD="${SCAFFOLD_PROMPT/__PROJECT_TYPE__/$PROJECT_TYPE}"

  run_stage "$SESSION_ID" "⚙️" "Scaffolding" "$P_SCAFFOLD" "$SCAFFOLD_LOG"

  if grep -q "SCAFFOLD_COMPLETE" "$SCAFFOLD_LOG.raw" 2>/dev/null; then
    FRAMEWORK=$(grep "TEST_FRAMEWORK:" "$SCAFFOLD_LOG.raw" 2>/dev/null | tail -1 | sed 's/.*: *//')
    echo -e "  ⚙️  ${GREEN}✓${NC} Test infrastructure ready (${FRAMEWORK:-unknown})"
  else
    echo -e "  ⚙️  ${YELLOW}⚠${NC} Scaffold incomplete - continuing anyway"
  fi
  echo ""
fi

# Main loop
items_done=0
item_num=$((initial_incomplete - $(count_incomplete) + 1))

for iter in $(seq 1 $MAX); do
  LOG="$LOG_DIR/item${item_num}_$(date +%H%M%S)"

  remaining=$(count_incomplete)
  echo -e "${DIM}[debug] Loop iteration $iter: $remaining incomplete items in $PRD${NC}"
  [ "$remaining" -eq 0 ] && break

  CURRENT_ITEM=$(get_next_item)
  total_items=$initial_incomplete

  # Generate session ID for this item (reuse across all stages)
  SESSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')

  # Item header - PRIMARY visual hierarchy (bold box, prominent)
  echo ""
  echo -e "${CYAN}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${NC}"
  echo -e "${CYAN}┃${NC}  📋 ${CYAN}$CURRENT_ITEM${NC}"
  echo -e "${CYAN}┃${NC}     ${DIM}Item $item_num of $total_items${NC}"
  echo -e "${CYAN}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${NC}"

  # ═══════════════════════════════════════════════════════════
  # STAGE 1: PLAN
  # ═══════════════════════════════════════════════════════════
  # Create short slug (max 50 chars) from item text
  ITEM_SLUG=$(echo "$CURRENT_ITEM" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//' | cut -c1-50 | sed 's/-$//')
  PLAN_FILE=".claude/plans/${ITEM_SLUG}.md"
  mkdir -p .claude/plans

  # Build skill guidance for planning (with dynamic detection)
  DYNAMIC_SKILLS=$(detect_dynamic_skills "$CURRENT_ITEM" "plan")
  STAGE_SKILLS=$(merge_skills "$PLAN_SKILLS" "$DYNAMIC_SKILLS")
  SKILL_GUIDANCE=$(build_skill_guidance "$STAGE_SKILLS")
  P0="${PLAN_PROMPT/__PRD__/$PRD}"
  P0="${P0/__SKILL_GUIDANCE__/$SKILL_GUIDANCE}"
  [ -n "$RESUME_CONTEXT" ] && [ "$iter" -eq 1 ] && P0="RESUME CONTEXT:\n$RESUME_CONTEXT\n\n$P0"

  # Log skills used
  for skill in $STAGE_SKILLS; do echo "$skill" >> "$SKILL_LOG"; done

  run_stage "$SESSION_ID" "📝" "Planning" "$P0" "$LOG.plan" "true" "$STAGE_SKILLS"

  if grep -q "PLAN_COMPLETE" "$LOG.plan.raw" 2>/dev/null; then
    echo -e "  📝 ${GREEN}✓${NC} Plan created: $(pwd)/$PLAN_FILE"
  else
    echo -e "  📝 ${RED}✗${NC} Planning failed"
    sleep 2
    continue
  fi

  # ═══════════════════════════════════════════════════════════
  # STAGE 2: BUILD
  # ═══════════════════════════════════════════════════════════
  # Build skill guidance for building (with dynamic detection)
  DYNAMIC_SKILLS=$(detect_dynamic_skills "$CURRENT_ITEM" "build")
  STAGE_SKILLS=$(merge_skills "$BUILD_SKILLS" "$DYNAMIC_SKILLS")
  SKILL_GUIDANCE=$(build_skill_guidance "$STAGE_SKILLS")
  P1="${BUILD_PROMPT/__PLAN_FILE__/$PLAN_FILE}"
  P1="${P1/__SKILL_GUIDANCE__/$SKILL_GUIDANCE}"

  # Log skills used
  for skill in $STAGE_SKILLS; do echo "$skill" >> "$SKILL_LOG"; done

  run_stage "$SESSION_ID" "🔨" "Building" "$P1" "$LOG.build" "" "$STAGE_SKILLS"

  if grep -q "BUILD_COMPLETE" "$LOG.build.raw" 2>/dev/null; then
    TESTS=$(grep "TESTS_PASSED:" "$LOG.build.raw" 2>/dev/null | tail -1 | sed 's/.*: *//')
    echo -e "  🔨 ${GREEN}✓${NC} Build complete (tests: ${TESTS:-unknown})"
  else
    echo -e "  🔨 ${RED}✗${NC} Build failed"
    sleep 2
    continue
  fi

  # ═══════════════════════════════════════════════════════════
  # STAGE 3: REFACTOR OPPORTUNITY CHECK
  # ═══════════════════════════════════════════════════════════
  # Build skill guidance for cleaning (with dynamic detection)
  DYNAMIC_SKILLS=$(detect_dynamic_skills "$CURRENT_ITEM" "clean")
  STAGE_SKILLS=$(merge_skills "$CLEAN_SKILLS" "$DYNAMIC_SKILLS")
  SKILL_GUIDANCE=$(build_skill_guidance "$STAGE_SKILLS")
  P2="${CLEAN_PROMPT/__SKILL_GUIDANCE__/$SKILL_GUIDANCE}"

  # Log skills used
  for skill in $STAGE_SKILLS; do echo "$skill" >> "$SKILL_LOG"; done

  run_stage "$SESSION_ID" "🧹" "Refactor Opportunity Check" "$P2" "$LOG.clean" "" "$STAGE_SKILLS"

  if grep -q "CLEAN_COMPLETE" "$LOG.clean.raw" 2>/dev/null; then
    EXTRACTED=$(grep "METHODS_EXTRACTED:" "$LOG.clean.raw" 2>/dev/null | tail -1 | sed 's/.*: *//')
    RENAMED=$(grep "NAMES_IMPROVED:" "$LOG.clean.raw" 2>/dev/null | tail -1 | sed 's/.*: *//')
    echo -e "  🧹 ${GREEN}✓${NC} Clean complete (${EXTRACTED:-0} extracted, ${RENAMED:-0} renamed)"
  elif grep -q "CLEAN_SKIPPED" "$LOG.clean.raw" 2>/dev/null; then
    echo -e "  🧹 ${YELLOW}○${NC} Nothing to refactor"
  else
    echo -e "  🧹 ${GREEN}✓${NC} Clean complete"
  fi

  # ═══════════════════════════════════════════════════════════
  # STAGE 4: TEST
  # ═══════════════════════════════════════════════════════════
  # Build skill guidance for testing (with dynamic detection)
  DYNAMIC_SKILLS=$(detect_dynamic_skills "$CURRENT_ITEM" "test")
  STAGE_SKILLS=$(merge_skills "$TEST_SKILLS" "$DYNAMIC_SKILLS")
  SKILL_GUIDANCE=$(build_skill_guidance "$STAGE_SKILLS")
  P3="${TEST_PROMPT/__SKILL_GUIDANCE__/$SKILL_GUIDANCE}"

  # Log skills used
  for skill in $STAGE_SKILLS; do echo "$skill" >> "$SKILL_LOG"; done

  run_stage "$SESSION_ID" "🧪" "Testing" "$P3" "$LOG.test" "" "$STAGE_SKILLS"

  if grep -q "TEST_COMPLETE" "$LOG.test.raw" 2>/dev/null; then
    PASSED=$(grep "TESTS_PASSED:" "$LOG.test.raw" 2>/dev/null | tail -1 | sed 's/.*: *//')
    TOTAL=$(grep "TESTS_TOTAL:" "$LOG.test.raw" 2>/dev/null | tail -1 | sed 's/.*: *//')
    echo -e "  🧪 ${GREEN}✓${NC} Tests passed (${PASSED:-all}/${TOTAL:-all})"
  else
    echo -e "  🧪 ${RED}✗${NC} Tests failed"
  fi

  # ═══════════════════════════════════════════════════════════
  # STAGE 5: EXTERNAL STATIC ANALYSIS (Qodana)
  # ═══════════════════════════════════════════════════════════
  if [ "$SKIP_SCAN" = true ]; then
    echo -e "  🔍 ${YELLOW}○${NC} Code scan skipped (--skip-scan)"
  elif command -v qodana &>/dev/null; then
    echo -e "  🔍 ${CYAN}External Static Analysis (Qodana)...${NC}"

    QODANA_CMD="qodana scan --project-dir . --results-dir .qodana/results"
    [ -f "$BASELINE_FILE" ] && QODANA_CMD="$QODANA_CMD --baseline $BASELINE_FILE"

    # Run Qodana scan (this runs in Docker by default)
    $QODANA_CMD > "$LOG.scan.log" 2>&1

    QODANA_FIXED=0
    QODANA_TOTAL=0

    if [ -f ".qodana/results/qodana.sarif.json" ]; then
      # Count issues by severity
      CRIT=$(jq '[.runs[].results[] | select(.level == "error")] | length' .qodana/results/qodana.sarif.json 2>/dev/null || echo 0)
      WARN=$(jq '[.runs[].results[] | select(.level == "warning")] | length' .qodana/results/qodana.sarif.json 2>/dev/null || echo 0)
      QODANA_TOTAL=$((CRIT + WARN))

      if [ "$CRIT" -gt 0 ]; then
        echo -e "  🔍 ${YELLOW}Found $CRIT critical, $WARN warnings${NC}"

        # Extract issues with file paths and messages
        ISSUES=$(jq -r '.runs[].results[] | select(.level == "error") | "FILE: \(.locations[0].physicalLocation.artifactLocation.uri)\nLINE: \(.locations[0].physicalLocation.region.startLine)\nRULE: \(.ruleId)\nMESSAGE: \(.message.text)\n---"' .qodana/results/qodana.sarif.json 2>/dev/null | head -200)

        # Display issues found
        echo -e "  ${DIM}─────────────────────────────────────────${NC}"
        jq -r '.runs[].results[] | select(.level == "error") | "  \(.locations[0].physicalLocation.artifactLocation.uri):\(.locations[0].physicalLocation.region.startLine) - \(.ruleId)"' .qodana/results/qodana.sarif.json 2>/dev/null | head -10
        [ "$CRIT" -gt 10 ] && echo -e "  ${DIM}... and $((CRIT - 10)) more${NC}"
        echo -e "  ${DIM}─────────────────────────────────────────${NC}"
        echo -e "  🔧 ${CYAN}Fixing...${NC}"

        # Build fix prompt
        read -r -d '' QODANA_FIX_PROMPT << QODANA_EOF || true
FIX QODANA STATIC ANALYSIS ISSUES

Found $CRIT critical issues that MUST be fixed.

For EACH issue below:
1. Read the file mentioned
2. Go to the line number
3. Understand the issue from the rule and message
4. Fix the code
5. After fixing all issues, commit: git commit -m "fix: resolve Qodana static analysis issues"

ISSUES TO FIX:
$ISSUES

After fixing, output:
QODANA_FIXED: [count of issues fixed]
SCAN_FIX_COMPLETE
QODANA_EOF

        run_stage "$SESSION_ID" "🔧" "Fixing Qodana issues" "$QODANA_FIX_PROMPT" "$LOG.scan.fix"

        # Parse fix results
        QODANA_FIXED=$(grep -o 'QODANA_FIXED:[[:space:]]*[0-9]*' "$LOG.scan.fix.json" 2>/dev/null | tail -1 | sed 's/.*:[[:space:]]*//')
        QODANA_FIXED=${QODANA_FIXED:-0}

        # Re-run Qodana to verify fixes
        echo -e "  🔍 ${CYAN}Verifying fixes...${NC}"
        $QODANA_CMD > "$LOG.scan.verify.log" 2>&1

        if [ -f ".qodana/results/qodana.sarif.json" ]; then
          NEW_CRIT=$(jq '[.runs[].results[] | select(.level == "error")] | length' .qodana/results/qodana.sarif.json 2>/dev/null || echo 0)
          if [ "$NEW_CRIT" -eq 0 ]; then
            echo -e "  🔍 ${GREEN}✓${NC} All critical issues fixed ($QODANA_FIXED fixed)"
          else
            echo -e "  🔍 ${YELLOW}⚠${NC} $NEW_CRIT critical issues remain (${QODANA_FIXED:-0} fixed)"
          fi
        fi
      elif [ "$WARN" -gt 0 ]; then
        echo -e "  🔍 ${GREEN}✓${NC} No critical issues ($WARN warnings)"
        # Show top warnings
        echo -e "  ${DIM}Warnings (not auto-fixed):${NC}"
        jq -r '.runs[].results[] | select(.level == "warning") | "  \(.locations[0].physicalLocation.artifactLocation.uri):\(.locations[0].physicalLocation.region.startLine) - \(.ruleId)"' .qodana/results/qodana.sarif.json 2>/dev/null | head -5
        [ "$WARN" -gt 5 ] && echo -e "  ${DIM}... and $((WARN - 5)) more warnings${NC}"
      else
        echo -e "  🔍 ${GREEN}✓${NC} No issues found"
      fi
    else
      echo -e "  🔍 ${YELLOW}○${NC} Scan produced no results"
    fi
  else
    echo -e "  🔍 ${YELLOW}○${NC} Qodana not installed"
  fi

  # ═══════════════════════════════════════════════════════════
  # STAGE 6: ADVERSARIAL REVIEW (Gemini)
  # ═══════════════════════════════════════════════════════════
  # Build skill guidance for review (with dynamic detection)
  DYNAMIC_SKILLS=$(detect_dynamic_skills "$CURRENT_ITEM" "review")
  STAGE_SKILLS=$(merge_skills "$REVIEW_SKILLS" "$DYNAMIC_SKILLS")
  SKILL_GUIDANCE=$(build_skill_guidance "$STAGE_SKILLS")
  P5="${REVIEW_PROMPT/__SKILL_GUIDANCE__/$SKILL_GUIDANCE}"

  # Log skills used
  for skill in $STAGE_SKILLS; do echo "$skill" >> "$SKILL_LOG"; done

  run_stage "$SESSION_ID" "👁️" "Adversarial Review (Gemini)" "$P5" "$LOG.review" "" "$STAGE_SKILLS"

  # Extract review results from .raw file
  # Handle markdown formatted output (**GEMINI_ISSUES:** 16) - extract number after **
  GEMINI_ISSUES=$(grep -oE '\*\*GEMINI_ISSUES:\*\*[[:space:]]*[0-9]+' "$LOG.review.raw" 2>/dev/null | tail -1 | sed 's/.*\*\*[[:space:]]*//')
  CRITICAL_HIGH=$(grep -oE '\*\*CRITICAL_HIGH:\*\*[[:space:]]*[0-9]+' "$LOG.review.raw" 2>/dev/null | tail -1 | sed 's/.*\*\*[[:space:]]*//')
  FIXED=$(grep -oE '\*\*ISSUES_FIXED:\*\*[[:space:]]*[0-9]+' "$LOG.review.raw" 2>/dev/null | tail -1 | sed 's/.*\*\*[[:space:]]*//')
  DEFERRED=$(grep -oE '\*\*ISSUES_DEFERRED:\*\*[[:space:]]*[0-9]+' "$LOG.review.raw" 2>/dev/null | tail -1 | sed 's/.*\*\*[[:space:]]*//')
  CLEAN=$(grep -oE '\*\*VERIFIED_CLEAN:\*\*[[:space:]]*(yes|no)' "$LOG.review.raw" 2>/dev/null | tail -1 | sed 's/.*\*\*[[:space:]]*//')

  # Fallback: try plain format (GEMINI_ISSUES: 16)
  if [ -z "$GEMINI_ISSUES" ]; then
    GEMINI_ISSUES=$(grep -oE 'GEMINI_ISSUES:[[:space:]]*[0-9]+' "$LOG.review.raw" 2>/dev/null | tail -1 | sed 's/.*:[[:space:]]*//')
    CRITICAL_HIGH=$(grep -oE 'CRITICAL_HIGH:[[:space:]]*[0-9]+' "$LOG.review.raw" 2>/dev/null | tail -1 | sed 's/.*:[[:space:]]*//')
    FIXED=$(grep -oE 'ISSUES_FIXED:[[:space:]]*[0-9]+' "$LOG.review.raw" 2>/dev/null | tail -1 | sed 's/.*:[[:space:]]*//')
    DEFERRED=$(grep -oE 'ISSUES_DEFERRED:[[:space:]]*[0-9]+' "$LOG.review.raw" 2>/dev/null | tail -1 | sed 's/.*:[[:space:]]*//')
    CLEAN=$(grep -oE 'VERIFIED_CLEAN:[[:space:]]*(yes|no)' "$LOG.review.raw" 2>/dev/null | tail -1 | sed 's/.*:[[:space:]]*//')
  fi

  if [ -n "$GEMINI_ISSUES" ] && [ "$GEMINI_ISSUES" != "0" ]; then
    if [ "$CLEAN" = "yes" ]; then
      echo -e "  👁️ ${GREEN}✓${NC} Gemini: ${GEMINI_ISSUES} issues (${CRITICAL_HIGH:-?} critical/high), ${FIXED:-0} fixed, verified clean"
    else
      echo -e "  👁️ ${YELLOW}⚠${NC} Gemini: ${GEMINI_ISSUES} issues (${CRITICAL_HIGH:-?} critical/high), ${FIXED:-0} fixed, ${DEFERRED:-0} deferred"
      # Show unfixed critical/high issues if any
      UNFIXED=$(grep -oE 'UNFIXED_ISSUES:.*' "$LOG.review.raw" 2>/dev/null | head -1)
      if [ -n "$UNFIXED" ]; then
        echo -e "  ${RED}Unfixed Critical/High:${NC}"
        # Extract lines after UNFIXED_ISSUES until next section
        sed -n '/UNFIXED_ISSUES:/,/^[A-Z_]*:/p' "$LOG.review.raw" 2>/dev/null | grep "^\- " | head -5 | while read line; do
          echo -e "  ${DIM}$line${NC}"
        done
      fi
    fi
  elif [ -n "$GEMINI_ISSUES" ]; then
    echo -e "  👁️ ${GREEN}✓${NC} Gemini: 0 issues found"
  else
    # Check if gemini_review was actually called
    if grep -q "gemini_review\|gemini-reviewer" "$LOG.review.json" 2>/dev/null; then
      echo -e "  👁️ ${YELLOW}○${NC} Gemini: review ran but output format unrecognized"
    else
      echo -e "  👁️ ${RED}✗${NC} Gemini: MCP tool was NOT called (review incomplete)"
    fi
  fi

  # ═══════════════════════════════════════════════════════════
  # STAGE 7: DOCUMENTATION
  # ═══════════════════════════════════════════════════════════
  # Build skill guidance for documentation (with dynamic detection)
  DYNAMIC_SKILLS=$(detect_dynamic_skills "$CURRENT_ITEM" "doc")
  STAGE_SKILLS=$(merge_skills "$DOC_SKILLS" "$DYNAMIC_SKILLS")
  SKILL_GUIDANCE=$(build_skill_guidance "$STAGE_SKILLS")
  P6="${DOC_PROMPT/__SKILL_GUIDANCE__/$SKILL_GUIDANCE}"

  # Log skills used
  for skill in $STAGE_SKILLS; do echo "$skill" >> "$SKILL_LOG"; done

  run_stage "$SESSION_ID" "📚" "Documentation" "$P6" "$LOG.doc" "" "$STAGE_SKILLS"

  if grep -q "DOC_COMPLETE" "$LOG.doc.raw" 2>/dev/null; then
    FILES_DOC=$(grep "FILES_DOCUMENTED:" "$LOG.doc.raw" 2>/dev/null | tail -1 | sed 's/.*: *//')
    README=$(grep "README_UPDATED:" "$LOG.doc.raw" 2>/dev/null | tail -1 | sed 's/.*: *//')
    echo -e "  📚 ${GREEN}✓${NC} Documentation complete (${FILES_DOC:-0} files, README: ${README:-no})"
  else
    echo -e "  📚 ${GREEN}✓${NC} Documentation complete"
  fi

  # ═══════════════════════════════════════════════════════════
  # COMPLETE
  # ═══════════════════════════════════════════════════════════
  mark_complete "$CURRENT_ITEM"
  NEW_REM=$(count_incomplete)

  # Debug: show what mark_complete did
  echo -e "${DIM}  [debug] Marked complete. PRD now has $NEW_REM incomplete items.${NC}"

  echo ""
  echo ""
  if [ "$NEW_REM" -eq 0 ]; then
    echo -e "  ${GREEN}✓ Item complete${NC} ${DIM}— all done!${NC}"
  else
    echo -e "  ${GREEN}✓ Item complete${NC} ${DIM}→ $NEW_REM remaining${NC}"
  fi

  items_done=$((items_done + 1))
  item_num=$((item_num + 1))

  # Checkpoint every 3 items
  if [ $((items_done % 3)) -eq 0 ]; then
    ts=$(date +%Y-%m-%dT%H-%M-%S)
    PROG="$SESSIONS_DIR/progress-${ts}.md"
    cat > "$PROG" << CHECKPOINT
# Ralph Progress - $ts
PRD: $PRD ($items_done items done, $NEW_REM remaining)
Last item: $CURRENT_ITEM
Resume: ralph $PRD --resume
CHECKPOINT
    git add "$PROG" && git commit -m "Checkpoint: $items_done items" 2>/dev/null || true
    echo -e "${DIM}Checkpoint saved${NC}"
  fi

  sleep 1
done

# Final report
echo ""
remaining=$(count_incomplete)
done_count=$((initial_incomplete - remaining))
if [ "$remaining" -eq 0 ]; then
  echo -e "${GREEN}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${NC}"
  echo -e "${GREEN}┃${NC}  ✅ ${GREEN}Complete${NC} — All $done_count items done!"
  echo -e "${GREEN}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${NC}"
else
  echo -e "${YELLOW}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${NC}"
  echo -e "${YELLOW}┃${NC}  📊 ${CYAN}Summary${NC}: $done_count/$initial_incomplete complete, $remaining remaining"
  echo -e "${YELLOW}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${NC}"
fi
echo ""
echo -e "${DIM}PRD Status:${NC}"
grep -E "^[[:space:]]*[-*+][[:space:]]*\[" "$PRD" | head -10 | while read line; do
  if echo "$line" | grep -q '\[x\]'; then
    echo -e "  ${GREEN}$line${NC}"
  else
    echo -e "  ${DIM}$line${NC}"
  fi
done

# Skill invocation summary
if [ -s "$SKILL_LOG" ]; then
  echo ""
  echo -e "${CYAN}Skills Invoked:${NC}"
  # Count and sort skills, display in columns
  sort "$SKILL_LOG" | uniq -c | sort -rn | while read count skill; do
    printf "  ${GREEN}%-20s${NC} %d\n" "/$skill" "$count"
  done
  total_skills=$(wc -l < "$SKILL_LOG" | tr -d ' ')
  unique_skills=$(sort "$SKILL_LOG" | uniq | wc -l | tr -d ' ')
  echo -e "${DIM}  Total: $total_skills invocations, $unique_skills unique skills${NC}"
fi

echo ""
echo -e "${DIM}Logs: $LOG_DIR${NC}"
