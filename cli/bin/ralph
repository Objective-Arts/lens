#!/bin/bash
#
# ralph - Autonomous PRD implementation with quality gates
#
# Usage:
#   ralph PRD.md --yes           # Run autonomously
#   ralph PRD.md --resume        # Continue from checkpoint
#   ralph PRD.md --skip-scan     # Skip Qodana scan
#   ralph --create-baseline      # Create Qodana baseline
#

set -e

# Track child PIDs for cleanup
CURRENT_SPINNER_PID=""
CURRENT_CLAUDE_PID=""

# Cleanup function to kill all child processes on exit
cleanup() {
  # Kill spinner if running
  [ -n "$CURRENT_SPINNER_PID" ] && kill $CURRENT_SPINNER_PID 2>/dev/null || true
  # Kill claude if running
  [ -n "$CURRENT_CLAUDE_PID" ] && kill $CURRENT_CLAUDE_PID 2>/dev/null || true
  # Kill entire process group (catches any other children)
  kill -- -$$ 2>/dev/null || true
}

# Trap all termination signals
trap cleanup EXIT INT TERM HUP

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

# Arguments
PRD="${1:-PRD.md}"
MAX=50
RESUME=false
YES=false
CREATE_BASELINE=false
SKIP_SCAN=false
LOG_DIR=".claude/ralph-logs"
SESSIONS_DIR=".claude/sessions"
BASELINE_FILE=".qodana/baseline.sarif.json"

for arg in "$@"; do
  case $arg in
    --resume) RESUME=true; YES=true ;;
    --yes|-y) YES=true ;;
    --max=*) MAX="${arg#*=}" ;;
    --create-baseline) CREATE_BASELINE=true ;;
    --skip-scan|--skip-qodana) SKIP_SCAN=true ;;
  esac
done

# Handle --create-baseline
if [ "$CREATE_BASELINE" = true ]; then
  echo "Creating Qodana baseline..."
  mkdir -p .qodana
  if qodana scan --project-dir . --results-dir .qodana/results > /dev/null 2>&1; then
    if [ -f ".qodana/results/qodana.sarif.json" ]; then
      cp .qodana/results/qodana.sarif.json "$BASELINE_FILE"
      ISSUE_COUNT=$(grep -c '"level": "error"' "$BASELINE_FILE" 2>/dev/null || echo 0)
      echo -e "${GREEN}✓${NC} Baseline created ($ISSUE_COUNT existing issues baselined)"
    fi
  else
    echo -e "${RED}✗${NC} Failed to create baseline"
  fi
  exit 0
fi

mkdir -p .claude "$LOG_DIR" "$SESSIONS_DIR"

# Skill tracking file for session summary
SKILL_LOG="$LOG_DIR/skills-$(date +%Y%m%d-%H%M%S).txt"
touch "$SKILL_LOG"

# Run stage with spinner and skill invocation feedback
# Usage: run_stage SESSION_ID icon name prompt logfile [is_first]
run_stage() {
  local session_id=$1
  local icon=$2
  local name=$3
  local prompt=$4
  local logfile=$5
  local is_first=$6
  local skills=$7

  local start=$(date +%s)

  # Print stage header - minimal design (Rams: less but better)
  echo ""
  echo -e "  ${DIM}────────────────────────────────────────────────────────────────────────────────────${NC}"
  echo -e "  $icon  ${CYAN}$name${NC}"
  if [ -n "$skills" ]; then
    local formatted_skills=""
    for s in $skills; do
      formatted_skills="$formatted_skills ${GREEN}$s${NC}"
    done
    echo -e "      Canon:$formatted_skills"
  fi
  echo ""

  # Start spinner in background (disown to suppress termination message)
  local spinstr='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  local spin_pid
  (
    trap 'exit 0' TERM INT
    while true; do
      for ((i=0; i<${#spinstr}; i++)); do
        printf "\r  ${DIM}${spinstr:$i:1} Working...${NC}"
        sleep 0.15
      done
    done
  ) 2>/dev/null &
  spin_pid=$!
  CURRENT_SPINNER_PID=$spin_pid
  disown $spin_pid 2>/dev/null

  # Run claude with stream-json to capture skill invocations
  # < /dev/null prevents stdin blocking, || true prevents set -e from exiting on pipeline failures
  claude --dangerously-skip-permissions \
    --output-format stream-json --verbose \
    -p "$prompt" < /dev/null 2>&1 | \
    tee "$logfile.json" | \
    grep --line-buffered -o '"skill":"[^"]*"\|"tool_use"' | \
    while IFS= read -r match; do
      # Kill spinner on first output
      if kill -0 $spin_pid 2>/dev/null; then
        kill $spin_pid 2>/dev/null
        wait $spin_pid 2>/dev/null
        printf "\r\033[K"  # Clear line completely
        sleep 0.05  # Brief pause to ensure line is cleared
      fi
      if [[ "$match" == *'"skill":'* ]]; then
        skill=$(echo "$match" | sed 's/"skill":"//;s/"//')
        printf "\r\033[K"  # Ensure clean line before skill
        desc=$(skill_desc "$skill")
        if [ -n "$desc" ]; then
          echo -e "  ${GREEN}⚡ /$skill${NC} ${DIM}($desc)${NC}"
        else
          echo -e "  ${GREEN}⚡ /$skill${NC}"
        fi
        echo "$skill" >> "$SKILL_LOG"
      else
        # Print a dot for each tool use to show progress
        printf "."
      fi
    done || true

  # Kill spinner if still running (no output case)
  if kill -0 $spin_pid 2>/dev/null; then
    kill $spin_pid 2>/dev/null
    wait $spin_pid 2>/dev/null
    printf "\r\033[K"  # Clear line completely
  fi
  CURRENT_SPINNER_PID=""

  # Extract final result from stream-json output
  # Extract final result - try "result" field first
  grep -o '"result":"[^"]*"' "$logfile.json" 2>/dev/null | tail -1 | sed 's/"result":"//;s/"$//' > "$logfile.raw" || true
  # If result is empty, search text blocks for the summary (contains REVIEW_COMPLETE or similar markers)
  if [ ! -s "$logfile.raw" ]; then
    # Look for text containing summary markers
    grep -o '"text":"[^"]*REVIEW_COMPLETE[^"]*"' "$logfile.json" 2>/dev/null | tail -1 | sed 's/"text":"//;s/"$//' > "$logfile.raw" || true
  fi
  if [ ! -s "$logfile.raw" ]; then
    grep -o '"text":"[^"]*GEMINI_ISSUES[^"]*"' "$logfile.json" 2>/dev/null | tail -1 | sed 's/"text":"//;s/"$//' > "$logfile.raw" || true
  fi
  if [ ! -s "$logfile.raw" ]; then
    grep -o '"text":"[^"]*_COMPLETE[^"]*"' "$logfile.json" 2>/dev/null | tail -1 | sed 's/"text":"//;s/"$//' > "$logfile.raw" || true
  fi

  local elapsed=$(($(date +%s) - start))
  echo ""
  echo "  ✓ $name done ($(format_time $elapsed))"
}


# Helper functions
count_incomplete() {
  grep -cE "^[[:space:]]*[-*+][[:space:]]*\[[[:space:]]\]" "$PRD" 2>/dev/null | head -1 || echo 0
}

get_next_item() {
  grep -E "^[[:space:]]*[-*+][[:space:]]*\[[[:space:]]\]" "$PRD" | head -1 | sed 's/^[[:space:]]*[-*+][[:space:]]*\[[[:space:]]\][[:space:]]*//'
}

mark_complete() {
  # Find the line number of the first incomplete item and mark it complete
  local line_num=$(grep -nE "^[[:space:]]*[-*+][[:space:]]*\[[[:space:]]\]" "$PRD" | head -1 | cut -d: -f1)
  if [ -n "$line_num" ]; then
    # Replace [ ] with [x] on that specific line
    sed -i.bak "${line_num}s/\[[[:space:]]\]/[x]/" "$PRD"
    rm -f "$PRD.bak"
  fi
}

format_time() {
  local secs=$1
  printf "%02d:%02d" $((secs / 60)) $((secs % 60))
}

# Brief description for each skill
skill_desc() {
  case "$1" in
    # Composite skills (chain to individuals)
    planning-masters) echo "→ kernighan, pike, dijkstra, bloch..." ;;
    security-canon) echo "→ schneier, owasp, threat-model..." ;;
    testing-experts) echo "→ dodds, meszaros, hevery..." ;;
    docs-masters) echo "→ procida, tufte, strunk-white..." ;;
    refactor-masters) echo "→ kernighan, feathers, gang-of-four..." ;;
    # Individual experts
    kernighan) echo "clarity" ;;
    pike) echo "simplicity" ;;
    thompson) echo "elegance" ;;
    mcilroy) echo "unix philosophy" ;;
    dijkstra) echo "correctness" ;;
    knuth) echo "algorithms" ;;
    linus) echo "taste" ;;
    bloch) echo "API design" ;;
    liskov) echo "contracts" ;;
    cherny) echo "type-driven" ;;
    crockford) echo "JS patterns" ;;
    hejlsberg) echo "type systems" ;;
    gang-of-four) echo "design patterns" ;;
    feathers) echo "refactoring" ;;
    schneier|bruce-schneier) echo "security mindset" ;;
    security-mindset) echo "think like attacker" ;;
    owasp) echo "secure coding" ;;
    tanya-janca) echo "appsec" ;;
    troy-hunt) echo "breach lessons" ;;
    threat-model) echo "threat analysis" ;;
    defense-in-depth) echo "layered security" ;;
    leveson) echo "safety engineering" ;;
    dodds) echo "testing" ;;
    meszaros) echo "test patterns" ;;
    fowler-test) echo "test strategy" ;;
    hevery) echo "testable code" ;;
    procida) echo "diátaxis" ;;
    tufte) echo "information design" ;;
    strunk-white) echo "concise writing" ;;
    zinsser) echo "clarity in prose" ;;
    taleb) echo "antifragile" ;;
    petroski) echo "failure analysis" ;;
    *) echo "" ;;
  esac
}

# ═══════════════════════════════════════════════════════════
# DYNAMIC SKILL LOADING FROM PROFILE CONFIG
# ═══════════════════════════════════════════════════════════

RALPH_CONFIG=".claude/ralph-config.yaml"
SKILLS_DIR=".claude/skills"

# ═══════════════════════════════════════════════════════════
# REQUIRE CONFIGURATION
# Ralph must have a config file - no fallback defaults
# ═══════════════════════════════════════════════════════════

if [ ! -f "$RALPH_CONFIG" ]; then
  echo -e "${RED}Error:${NC} Ralph configuration not found: $RALPH_CONFIG"
  echo ""
  echo "Ralph requires a profile to be applied before running."
  echo "This ensures skills are tailored to your project type."
  echo ""
  echo -e "${CYAN}To fix:${NC}"
  echo "  cc-config profile apply <profile-name>"
  echo ""
  echo "Examples:"
  echo "  cc-config profile apply javascript+ralph-integration"
  echo "  cc-config profile apply python+ralph-integration"
  echo "  cc-config profile apply react+ralph-integration"
  echo ""
  echo "Run 'cc-config profile list' to see available profiles."
  exit 1
fi

# Check if yq is available for YAML parsing
if ! command -v yq &>/dev/null; then
  echo -e "${RED}Error:${NC} yq is required to parse ralph configuration"
  echo ""
  echo -e "${CYAN}To install:${NC}"
  echo "  brew install yq"
  exit 1
fi

# Read skills from config
read_skills_from_config() {
  local stage="$1"
  yq -r ".skills.$stage | join(\" \")" "$RALPH_CONFIG" 2>/dev/null || echo ""
}

# Load skill content from .claude/skills/[name]/SKILL.md
load_skill_from_file() {
  local skill_name="$1"
  local skill_file="$SKILLS_DIR/$skill_name/SKILL.md"
  if [ -f "$skill_file" ]; then
    # Extract a condensed version (first 20 lines or until ----)
    head -50 "$skill_file" | grep -v "^#" | head -15
  else
    echo ""
  fi
}

# Load skill sets from config (config file validated above)
PLAN_SKILLS=$(read_skills_from_config "plan")
BUILD_SKILLS=$(read_skills_from_config "build")
CLEAN_SKILLS=$(read_skills_from_config "clean")
TEST_SKILLS=$(read_skills_from_config "test")
REVIEW_SKILLS=$(read_skills_from_config "review")
DOC_SKILLS=$(read_skills_from_config "doc")
CONFIG_SOURCE="profile"

# Detect project type for display (no longer affects skills - profile handles that)
if [ -f "tsconfig.json" ] || { [ -f "package.json" ] && grep -q '"typescript"' package.json 2>/dev/null; }; then
  PROJECT_TYPE="TypeScript"
  if grep -q '"react"' package.json 2>/dev/null; then
    PROJECT_TYPE="TypeScript/React"
  fi
elif [ -f "package.json" ]; then
  PROJECT_TYPE="JavaScript"
  if grep -q '"react"' package.json 2>/dev/null; then
    PROJECT_TYPE="React"
  fi
elif [ -f "pyproject.toml" ] || [ -f "setup.py" ] || [ -f "requirements.txt" ]; then
  PROJECT_TYPE="Python"
elif [ -f "go.mod" ]; then
  PROJECT_TYPE="Go"
elif [ -f "Cargo.toml" ]; then
  PROJECT_TYPE="Rust"
elif [ -f "Gemfile" ]; then
  PROJECT_TYPE="Ruby"
elif [ -f "*.csproj" ] || [ -f "*.sln" ]; then
  PROJECT_TYPE="C#"
else
  PROJECT_TYPE="Unknown"
fi

# ═══════════════════════════════════════════════════════════
# EMBEDDED CANON MASTERS (condensed guidance)
# ═══════════════════════════════════════════════════════════

read -r -d '' SKILL_KERNIGHAN << 'SKILL_EOF' || true
## Kernighan: Clarity Above All
- Code is read more than written - favor the reader
- "If you write code as cleverly as possible, you're not smart enough to debug it"
- Say what you mean, simply and directly
- Choose straightforward over clever, always
- Names should explain purpose, not implementation
- Small functions that do one thing
- No magic numbers - use named constants
- Comments explain WHY, not what
SKILL_EOF

read -r -d '' SKILL_PIKE << 'SKILL_EOF' || true
## Pike: Simplicity in Systems
- Simplicity is the ultimate sophistication
- Do less, but do it well
- Data dominates - get data structures right, code follows
- Clear is better than clever
- Avoid unnecessary abstraction
- Composition over inheritance
- Make zero values useful
SKILL_EOF

read -r -d '' SKILL_DIJKSTRA << 'SKILL_EOF' || true
## Dijkstra: Correctness by Construction
- Program testing shows presence of bugs, not absence
- Build programs that are obviously correct
- Separate concerns ruthlessly
- Avoid goto/complex control flow
- Prove invariants hold
- Make illegal states unrepresentable
- Formal reasoning over debugging
SKILL_EOF

read -r -d '' SKILL_MCILROY << 'SKILL_EOF' || true
## McIlroy: Unix Philosophy
- Do one thing and do it well
- Write programs to work together
- Text streams are universal interface
- Small, sharp tools over monoliths
- Avoid captive user interfaces
- Build filters, not frameworks
SKILL_EOF

read -r -d '' SKILL_THOMPSON << 'SKILL_EOF' || true
## Thompson: Elegant Minimalism
- When in doubt, leave it out
- Delete code rather than add
- The best code is no code
- Simple algorithms on simple data structures
- Correctness first, then performance
SKILL_EOF

read -r -d '' SKILL_BLOCH << 'SKILL_EOF' || true
## Bloch: API Design
- Make APIs hard to misuse
- Fail fast - report errors early
- Minimize mutability
- Favor composition over inheritance
- Design for inheritance or prohibit it
- Use interfaces for flexibility
- Document all public elements
SKILL_EOF

read -r -d '' SKILL_LISKOV << 'SKILL_EOF' || true
## Liskov: Substitution Principle
- Subtypes must be substitutable for base types
- Don't violate base class contracts
- Preconditions can't be strengthened
- Postconditions can't be weakened
- Invariants must be preserved
- Prefer composition when LSP would be violated
SKILL_EOF

read -r -d '' SKILL_CHERNY << 'SKILL_EOF' || true
## Cherny: Type-Driven Development (TypeScript)
- Let types guide your design
- Make illegal states unrepresentable
- Use discriminated unions for state
- Prefer interfaces over type aliases for objects
- Use generics for reusable code
- Strict mode always
- Avoid any - use unknown when uncertain
SKILL_EOF

read -r -d '' SKILL_CROCKFORD << 'SKILL_EOF' || true
## Crockford: JavaScript Good Parts
- Use strict mode always
- Avoid the bad parts (with, eval, ==)
- Use === and !== exclusively
- Declare variables at function top
- Use closures for privacy
- Prefer object literals over constructors
- Avoid this when possible
SKILL_EOF

read -r -d '' SKILL_HETTINGER << 'SKILL_EOF' || true
## Hettinger: Pythonic Patterns
- Beautiful is better than ugly
- Use iterators and generators
- Embrace duck typing
- Use context managers
- Prefer list comprehensions
- Named tuples for simple data
- dataclasses for structured data
SKILL_EOF

read -r -d '' SKILL_SCHNEIER << 'SKILL_EOF' || true
## Schneier: Security Mindset
- Think like an attacker
- Defense in depth - multiple layers
- Fail securely - deny by default
- Least privilege always
- Don't invent your own crypto
- Assume breach - limit blast radius
- Security is a process, not a product
SKILL_EOF

read -r -d '' SKILL_OWASP << 'SKILL_EOF' || true
## OWASP: Secure Coding
- Validate all input, encode all output
- Parameterized queries always (no SQL injection)
- Escape output for context (HTML, JS, URL)
- Use secure session management
- Implement proper access controls
- Protect sensitive data in transit and at rest
- Log security events
SKILL_EOF

read -r -d '' SKILL_MESZAROS << 'SKILL_EOF' || true
## Meszaros: Test Patterns
- Tests should be independent
- One assertion concept per test
- Use test doubles appropriately (stub, mock, fake)
- Avoid test logic - keep tests simple
- Fast tests run more often
- Test behavior, not implementation
- Arrange-Act-Assert structure
SKILL_EOF

read -r -d '' SKILL_FOWLER_TEST << 'SKILL_EOF' || true
## Fowler: Testing Strategy
- Test pyramid: many unit, some integration, few E2E
- Unit tests for logic, integration for boundaries
- Sociable vs solitary unit tests
- Contract tests for APIs
- Avoid test doubles for things you don't own
- Tests are documentation
SKILL_EOF

read -r -d '' SKILL_HEVERY << 'SKILL_EOF' || true
## Hevery: Testable Code
- Inject dependencies, don't construct them
- Avoid static methods and singletons
- Separate object construction from logic
- Keep constructors simple
- Avoid work in constructors
- Law of Demeter - don't reach through objects
SKILL_EOF

read -r -d '' SKILL_FEATHERS << 'SKILL_EOF' || true
## Feathers: Working with Legacy Code
- Legacy code is code without tests
- Find seams - places to inject test points
- Write characterization tests first
- Break dependencies carefully
- Sprout methods/classes for new code
- Preserve signatures during refactoring
- Small, safe steps
SKILL_EOF

read -r -d '' SKILL_GOF << 'SKILL_EOF' || true
## Gang of Four: Design Patterns
- Program to interfaces, not implementations
- Favor composition over inheritance
- Encapsulate what varies
- Strive for loosely coupled designs
- Use patterns for proven solutions
- Don't over-pattern - simplicity first
SKILL_EOF

read -r -d '' SKILL_PROCIDA << 'SKILL_EOF' || true
## Procida: Diataxis Documentation
- Four types: tutorials, how-tos, reference, explanation
- Tutorials: learning-oriented, get user started
- How-tos: task-oriented, solve problems
- Reference: information-oriented, accurate and complete
- Explanation: understanding-oriented, context and background
- Don't mix types in same document
SKILL_EOF

read -r -d '' SKILL_STRUNK << 'SKILL_EOF' || true
## Strunk & White: Concise Writing
- Omit needless words
- Use active voice
- Put statements in positive form
- Use definite, specific, concrete language
- Keep related words together
- Avoid fancy words when simple ones work
SKILL_EOF

# NOTE: Stage skills are loaded from profile config above (lines 301-306)
# The variables PLAN_SKILLS, BUILD_SKILLS, etc. are already set from .claude/ralph-config.yaml
# DO NOT override them with hardcoded defaults here - that would defeat the profile system

# Function to get skill content - tries file first, then embedded fallback
get_skill_content() {
  local skill_name="$1"
  local skill_file="$SKILLS_DIR/$skill_name/SKILL.md"

  # Try loading from file first
  if [ -f "$skill_file" ]; then
    # Extract condensed guidance (skip frontmatter, get key points)
    local content=""
    local in_content=false
    while IFS= read -r line; do
      # Skip frontmatter
      if [[ "$line" == "---" ]]; then
        if [ "$in_content" = false ]; then
          in_content=true
          continue
        fi
      fi
      # Skip empty lines at start
      [[ -z "$line" && -z "$content" ]] && continue
      # Add line to content
      content="$content$line
"
    done < <(head -40 "$skill_file")

    if [ -n "$content" ]; then
      echo "$content"
      return
    fi
  fi

  # Fallback to embedded content
  case "$skill_name" in
    kernighan) echo "$SKILL_KERNIGHAN" ;;
    pike) echo "$SKILL_PIKE" ;;
    dijkstra) echo "$SKILL_DIJKSTRA" ;;
    mcilroy) echo "$SKILL_MCILROY" ;;
    thompson) echo "$SKILL_THOMPSON" ;;
    bloch) echo "$SKILL_BLOCH" ;;
    liskov) echo "$SKILL_LISKOV" ;;
    cherny) echo "$SKILL_CHERNY" ;;
    crockford) echo "$SKILL_CROCKFORD" ;;
    hettinger) echo "$SKILL_HETTINGER" ;;
    schneier) echo "$SKILL_SCHNEIER" ;;
    owasp) echo "$SKILL_OWASP" ;;
    meszaros) echo "$SKILL_MESZAROS" ;;
    fowler-test) echo "$SKILL_FOWLER_TEST" ;;
    hevery) echo "$SKILL_HEVERY" ;;
    feathers) echo "$SKILL_FEATHERS" ;;
    gof|gang-of-four) echo "$SKILL_GOF" ;;
    procida) echo "$SKILL_PROCIDA" ;;
    strunk|strunk-white) echo "$SKILL_STRUNK" ;;
    *) echo "" ;;  # Unknown skill - will try to load from file only
  esac
}

# Build combined skill content for a stage
build_skill_guidance() {
  local skills="$1"
  local guidance=""
  for skill in $skills; do
    content=$(get_skill_content "$skill")
    if [ -n "$content" ]; then
      guidance="$guidance
$content
"
    fi
  done
  echo "$guidance"
}

# ═══════════════════════════════════════════════════════════
# DYNAMIC SKILL DETECTION
# Analyzes PRD item text and returns additional skills to add
# ═══════════════════════════════════════════════════════════

# UI/UX keywords and their skills
detect_dynamic_skills() {
  local item_text="$1"
  local stage="$2"
  local item_lower=$(echo "$item_text" | tr '[:upper:]' '[:lower:]')
  local extra_skills=""

  # UI/Frontend detection
  if echo "$item_lower" | grep -qE '(form|button|modal|dialog|input|dropdown|menu|navbar|sidebar|card|layout|component|ui|ux|page|view|screen|dashboard|widget|tooltip|popup|animation|transition|responsive|mobile|style|css|theme|dark mode|light mode)'; then
    case "$stage" in
      plan)   extra_skills="frost norman cooper" ;;
      build)  extra_skills="frost ive norman wroblewski duarte buxton curtis kruzeniski rams" ;;
      clean)  extra_skills="frost rams" ;;
      review) extra_skills="norman cooper" ;;
      doc)    extra_skills="tufte" ;;
    esac
  fi

  # API/Backend detection
  if echo "$item_lower" | grep -qE '(api|endpoint|route|rest|graphql|webhook|middleware|controller|handler|request|response|http|auth|jwt|token|session|cors)'; then
    case "$stage" in
      plan)   extra_skills="bloch" ;;
      build)  extra_skills="bloch" ;;
      review) extra_skills="schneier owasp" ;;
    esac
  fi

  # Database detection
  if echo "$item_lower" | grep -qE '(table|database|schema|migration|query|sql|index|foreign key|join|transaction|postgres|mysql|sqlite|mongo|redis|cache)'; then
    case "$stage" in
      review) extra_skills="schneier owasp" ;;
    esac
  fi

  # Security detection
  if echo "$item_lower" | grep -qE '(security|auth|password|encrypt|hash|token|permission|role|access|sanitize|validate|xss|csrf|injection|vulnerability)'; then
    case "$stage" in
      plan)   extra_skills="threat-model schneier security-mindset" ;;
      build)  extra_skills="tanya-janca owasp schneier" ;;
      test)   extra_skills="owasp troy-hunt" ;;
      review) extra_skills="schneier owasp security-mindset tanya-janca troy-hunt leveson taleb" ;;
    esac
  fi

  # Testing detection
  if echo "$item_lower" | grep -qE '(test|spec|coverage|mock|stub|fixture|e2e|integration test|unit test|tdd|bdd)'; then
    case "$stage" in
      plan)   extra_skills="meszaros fowler-test" ;;
      build)  extra_skills="meszaros fowler-test hevery" ;;
    esac
  fi

  # Performance detection
  if echo "$item_lower" | grep -qE '(performance|optimize|cache|lazy|async|parallel|batch|queue|throttle|debounce|memory|cpu|latency|throughput)'; then
    case "$stage" in
      plan)   extra_skills="carmack knuth" ;;
      build)  extra_skills="carmack knuth" ;;
      review) extra_skills="carmack" ;;
    esac
  fi

  # CLI/Tooling detection
  if echo "$item_lower" | grep -qE '(cli|command|terminal|shell|script|tool|plugin|extension|config|flag|argument|option)'; then
    case "$stage" in
      plan)   extra_skills="mcilroy pike kernighan" ;;
      build)  extra_skills="mcilroy pike kernighan" ;;
    esac
  fi

  echo "$extra_skills"
}

# Merge skills (deduplicate while preserving order)
merge_skills() {
  local base_skills="$1"
  local extra_skills="$2"
  local all_skills="$base_skills $extra_skills"
  local result=""
  for skill in $all_skills; do
    # Check if skill already in result (case statement avoids ! issues)
    case " $result " in
      *" $skill "*) ;;  # Already exists, skip
      *) result="$result $skill" ;;  # Add new skill
    esac
  done
  echo "$result" | sed 's/^ //'
}

