{
  "name": "cc-config",
  "version": "0.1.0",
  "description": "Claude Code configuration manager - manage skills, commands, agents, and CLAUDE.md across projects",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cc-config": "./dist/cli/index.js",
    "ralph": "./bin/ralph",
    "ralph-ts": "./dist/ralph/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "mkdir -p dist/ui && cp src/ui/*.html dist/ui/ 2>/dev/null || true",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest"
  },
  "keywords": [
    "claude-code",
    "configuration",
    "skills",
    "mcp"
  ],
  "author": "Steve",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
